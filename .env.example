# Architecture Zero - per-instance configuration.
# Copy to .env (next to docker-compose.yml) and edit. NEVER commit .env.
# Every value here has a working default in code; this file documents the
# ones an operator actually decides.

# --- Required before real use -------------------------------------------------
# Auth fails closed on the placeholder: with ENABLE_AUTH=true (the default)
# the backend refuses to boot until this is a real secret.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-before-deploying

# --- Identity -----------------------------------------------------------------
VITE_INSTANCE_NAME=Architecture Zero
# Optional owner-profile file pinned into every chat (path inside the
# container). Empty = no identity card.
IDENTITY_CARD_PATH=

# --- Models -------------------------------------------------------------------
# Local inference via Ollama. From inside the container, "localhost" is the
# container - host.docker.internal reaches the host's Ollama.
OLLAMA_BASE=http://host.docker.internal:11434
# Embeddings ALWAYS use a stable local endpoint, decoupled from chat
# inference - never point EMBED_BASE at a remote tunnel.
EMBED_BASE=http://host.docker.internal:11434
DEFAULT_MODEL=qwen3:8b
# Every Ollama request carries this context window; Ollama's own ~4k default
# silently truncates the system prompt (safety rules included) from the
# front. 0 = leave it to Ollama.
OLLAMA_NUM_CTX=32768
# Cloud providers activate when keyed (also settable in the admin UI).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=

# --- Access posture -----------------------------------------------------------
ENABLE_AUTH=true
# Guest (anonymous) chat is double-gated: this env opt-in AND the admin
# config toggle. Off by default - the instance is private.
ALLOW_GUEST_MODE=false
GUEST_MAX_TURNS=10
GUEST_MAX_TOKENS=1024
# Global cap on guest requests per UTC day, across ALL callers - the total-volume
# bound per-IP limits cannot give you (they do not stop distributed or
# IP-rotating traffic, and ENABLE_RATE_LIMIT is off by default, so on a stock
# deployment this is the only volume bound on the guest lane). It counts
# REQUESTS, not tokens: it bounds how many guest turns land in a day, not how
# large any one of them is. 0 disables. Counted in Redis when Redis is
# reachable, otherwise in-process: right for the single-container image, and
# per-worker under `uvicorn --workers N` or several replicas.
DEMO_DAILY_GUEST_LIMIT=0
# Anonymous sessions older than this are purged at boot (0 disables).
GUEST_RETENTION_DAYS=30
# Require an enrolled TOTP factor for every password login. ORDER MATTERS:
# enroll accounts first, flip this second - see knowledge/onboarding.md.
REQUIRE_MFA=false
# Sign-in bounds, all always enforced (no off switch - an auth boundary gated
# on an off-by-default flag is guarded in source and absent in deployment):
# wrong passwords lock the account; a live MFA challenge token is single-use
# and gets at most N wrong codes, with a TTL matching the token's 5-minute
# expiry; the unauthenticated first-owner claim endpoint (POST /api/auth/setup)
# is throttled per source address.
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
MFA_MAX_ATTEMPTS=5
MFA_CHALLENGE_TTL=300
SETUP_MAX_ATTEMPTS=5
SETUP_WINDOW=900

# First-Owner CLAIM CODE (2026-08-27). The throttle above bounds attempts; it
# cannot close the RACE, because one request is all it takes to claim a fresh
# deployment and one request is under every limit. So the claim also requires a
# code that only someone who can read this deployment's logs has seen.
#
# LEAVE THIS UNSET on a normal single-container deployment. The code is then
# generated at boot and printed to the container logs while the deployment is
# unclaimed - `docker compose logs backend` - and dies the moment the Owner is
# created. Nothing to provision, nothing to forget, no shared default.
#
# SET IT when the code cannot be read from a log, or must be stable:
#   - MULTI-WORKER / MULTI-REPLICA. The generated code lives in ONE process's
#     memory. Under `uvicorn --workers N` or several replicas each mints a
#     different code and only one would accept the operator's. This is the case
#     where leaving it unset is actively broken.
#   - Provisioned secrets (a Kubernetes secret, a sealed compose literal), or an
#     automated first-boot claim in CI.
# There is no way to turn the REQUIREMENT off. A control whose default state is
# off reads as guarded in the source and is absent in every real deployment.
# SETUP_CLAIM_CODE=

# Answer only from the corpus; refuse when retrieval finds nothing.
RAG_ONLY_MODE=false
# The browser origin allowed to call this API - set it to YOUR frontend's
# origin. `*` opens CORS to every origin AND disables the server-side origin
# check, so it is an explicit opt-out, not a default (see SECURITY.md).
CORS_ORIGIN=http://localhost:5173
# Extra allowed browser origins for an embedded widget (comma-separated).
WIDGET_ORIGINS=

# --- Content gates ------------------------------------------------------------
# Ingest-time injection scanning: off | tag | quarantine (default).
INJECTION_SCAN_MODE=quarantine
# PII scanning at ingest: off (default) | tag | redact. (If you move this
# value into a YAML file such as compose, quote it - bare `off` is a YAML
# boolean.)
PII_SCAN_MODE=off

# --- Reranker seam ------------------------------------------------------------
# local (in-image ONNX, default) | remote-http | hosted-api.
RERANK_PROVIDER=local
# remote-http: POST {query, texts, model} -> {scores} endpoint (a GPU box).
RERANK_REMOTE_URL=
# HARD PRIVACY LATCH: hosted-api ships candidate chunk text to the vendor.
# Only this host env can allow it - a DB config flip alone never can.
RERANK_HOSTED_ALLOWED=
# COHERE_API_KEY=
# VOYAGE_API_KEY=

# --- Eco Mode federation ------------------------------------------------------
# CONSUME side (query peers): register peers via the /api/peers API; the
# shared key your instance presents to peers:
# PEER_API_KEY=
# SERVE side (let peers query YOUR KB) - deliberate opt-in, off by default:
# ECO_EXPOSE_KB=true
# One key per caller, scoped: <key>:all or <key>:public (comma-separated).
# PEER_KEYS=

# --- Evals --------------------------------------------------------------------
# The pinned judge (must differ in provider family from the answer writer).
EVAL_JUDGE_MODEL=claude-sonnet-4-6
EVAL_QUESTION_PAUSE_SECONDS=2.0

# --- Operations ---------------------------------------------------------------
ENABLE_AUDIT_LOG=true
AUDIT_RETENTION_DAYS=365
MAX_UPLOAD_MB=50
BACKUP_RETENTION_DAYS=30
# Alerting (optional; webhook and/or SMTP) - see app/alerting.py.
# ALERT_WEBHOOK_URL=
# ALERT_EMAIL=
# ALERT_SMTP_HOST=
# ALERT_SMTP_PORT=
# ALERT_SMTP_USER=
# ALERT_SMTP_PASS=
# ALERT_FROM_EMAIL=
