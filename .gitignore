# Environments and secrets - nothing env-shaped is ever committed
.env
.env.*
# ...except the documented template, which holds placeholders only
!.env.example
*.pem
*.key

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Data and indexes
data/
# ...and any copy of it. A timestamped backup made while testing was committed
# once because `data/` matches only the exact directory name; the operator
# habit that produces these is universal, and the files are binary, so the
# residue guard cannot see them either.
# Any sibling copy at all, whatever it is called: a rename made for a local
# proof run (data.local-*, data.proof-*) was swept into a commit by `git add
# -A` on 2026-09-21 because only the .bak spelling was listed.
data.*/
*.bak/
*.db
chroma/

# Node
node_modules/
dist/

# OS noise
.DS_Store
Thumbs.db

# logo generator scratch
.github-assets/__pycache__/
